# Copy to .env.local and replace placeholders. Never commit real credentials.
# Required for the web app and database migration:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-cron-secret

# Required for email and billing features (use test/sandbox credentials locally):
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INVOICE_REMINDERS=
STRIPE_PRICE_COMPLIANCE=
STRIPE_PRICE_FIELD_SERVICE=

# Optional integrations/operations:
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
ADMIN_EMAIL=
# NEXTAUTH_SECRET is only used for legacy QuickBooks state signing.
NEXTAUTH_SECRET=
